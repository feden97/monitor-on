{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://data912.com/:path*" },
    { "source": "/cripto/:path*", "destination": "https://criptoya.com/:path*" },
    { "source": "/argdata/:path*", "destination": "https://api.argentinadatos.com/:path*" }
  ]
}
